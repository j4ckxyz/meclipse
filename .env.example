# Optional: enables full-address autocomplete. Without this, town and worldwide
# postcode search uses cached Open-Meteo, Postcodes.io and Photon fallbacks.
GEOAPIFY_API_KEY=

# Production visitor count. The Vercel Upstash integration may alternatively
# provide KV_REST_API_URL and KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VISITOR_HASH_SECRET=
VISITOR_COUNT_OFFSET=0

# Optional locally. Vercel supplies VITE_VERCEL_PROJECT_PRODUCTION_URL at build time.
VITE_SITE_URL=
